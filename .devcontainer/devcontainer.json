{
  "name": "jikoshoukai",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "minimal",
      "components": "clippy,rustfmt"
    }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "git config --global commit.gpgsign true && git config --global tag.gpgsign true"
}